{
  "rewrites": [
    { "source": "/login", "destination": "/api/server.js" },
    { "source": "/callback", "destination": "/api/server.js" },
    { "source": "/check-auth", "destination": "/api/server.js" },
    { "source": "/generate", "destination": "/api/server.js" },
    { "source": "/save-playlist", "destination": "/api/server.js" },
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    
    
    { "source": "/generatePlaylist", "destination": "/client/generatePlaylist.html" },
    { "source": "/playMusic", "destination": "/client/playMusic.html" },
    { "source": "/profile", "destination": "/client/profilePage.html" },
    { "source": "/", "destination": "/client/index.html" },
    { "source": "/(.*)", "destination": "/client/$1" }
  ]
}